# The registry records the calls of each service today. SV202 warns about a
# call that a changed service keeps, if the call breaks the layer rules.
exits 0 slint check specs/keep.yaml
cmp stdout keep.txt
exits 1 slint check --strict specs/keep.yaml

# The spec removes the call, so SV202 does not report it.
exits 0 slint check --strict specs/remove.yaml
stdout 'found 0 error\(s\) and 0 warning\(s\)'

# SV112: a removed call must be in the registry.
exits 1 slint check specs/unknown.yaml
stdout '^specs/unknown.yaml:12 error SV112 HookCommand does not call PolicyEngine in the registry \(removed_calls\[1\]\)$'

# A change inside one service has no calls. The services in services.changed
# cover each acceptance criterion. SV118 reports a spec with no calls and no
# changed service.
# SV202 still checks the calls that the changed service keeps.
exits 0 slint check specs/inside.yaml
stdout 'found 0 error\(s\) and 1 warning\(s\)'
stdout ' warning SV202 HookCommand calls ConfigAccessor'
! stdout 'SV107|SV118|SV201'
exits 1 slint check specs/nothing.yaml
stdout '^specs/nothing.yaml:8 error SV118 The spec has no calls and no service in services.changed \(calls\)$'
! stdout SV107

# SR008: each registered call is to a registered service.
cd $WORK/badcalls
exits 1 slint check
stdout '^.speclint/data/services.yaml:2 error SR008 "Nobody" in calls of OrderApi is not a registered service \(services.OrderApi.calls\[0\]\)$'

-- .speclint.yaml --
-- .speclint/data/services.yaml --
services:
  HookCommand: { layer: client, calls: [ConfigAccessor] }
  CheckManager: { layer: manager, calls: [ConfigAccessor] }
  ConfigAccessor: { layer: accessor }
-- specs/keep.yaml --
speclint: 1
id: KEEP-1
kind: chore
title: Keep a call
summary: The hook calls the manager, but it keeps its call to the accessor.
acceptance:
  - { id: AC1, text: "Given a spec, when Claude saves it, then the hook checks it." }
services:
  changed: [HookCommand]
calls:
  - { from: HookCommand, to: CheckManager, op: Check, covers: [AC1] }
-- specs/remove.yaml --
speclint: 1
id: REMOVE-1
kind: chore
title: Remove a call
summary: The hook calls the manager, and the manager finds the configuration.
acceptance:
  - { id: AC1, text: "Given a spec, when Claude saves it, then the hook checks it." }
services:
  changed: [HookCommand]
calls:
  - { from: HookCommand, to: CheckManager, op: Check, covers: [AC1] }
removed_calls:
  - { from: HookCommand, to: ConfigAccessor }
-- specs/unknown.yaml --
speclint: 1
id: UNKNOWN-1
kind: chore
title: Remove a call that is not there
summary: The spec removes a call that the registry does not have.
acceptance:
  - { id: AC1, text: "Given a spec, when Claude saves it, then the hook checks it." }
calls:
  - { from: HookCommand, to: CheckManager, op: Check, covers: [AC1] }
removed_calls:
  - { from: HookCommand, to: ConfigAccessor }
  - { from: HookCommand, to: PolicyEngine }
-- specs/inside.yaml --
speclint: 1
id: INSIDE-1
kind: chore
title: Change the hook only
summary: The hook writes a shorter message. It adds no call.
acceptance:
  - { id: AC1, text: "Given a spec with errors, when Claude saves it, then the message is short." }
services:
  changed: [HookCommand]
calls: []
-- specs/nothing.yaml --
speclint: 1
id: NOTHING-1
kind: chore
title: Change nothing
summary: The spec names no call and no service.
acceptance:
  - { id: AC1, text: "Given nothing, when nothing happens, then nothing changes." }
calls: []
-- keep.txt --
specs/keep.yaml:9 warning SV202 HookCommand calls ConfigAccessor in the registry, but clients cannot call accessors (services.changed[0])
    fix: This spec changes HookCommand, so fix the call. Add { from: HookCommand, to: ConfigAccessor } to removed_calls (a top-level list of the spec). Then move the work to a service that HookCommand can call: managers or utilities. If ConfigAccessor belongs in another layer, move it with services.relayered.
speclint checked 1 spec(s) and found 0 error(s) and 1 warning(s).
-- badcalls/.speclint.yaml --
-- badcalls/.speclint/data/services.yaml --
services:
  OrderApi: { layer: client, calls: [Nobody] }
