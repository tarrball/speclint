# A spec can move a registered service to another layer. The rules check the
# spec with the registry after the move.
exits 0 slint check --strict specs/move.yaml
stdout 'found 0 error\(s\) and 0 warning\(s\)'

# Without the move, the client cannot call the accessor.
exits 1 slint check specs/nomove.yaml
stdout '^specs/nomove.yaml:9 error SV102 HookCommand \(client\) cannot call ClaudeAccessor \(accessor\) \(calls\[0\]\)$'

# The moved service keeps a call that breaks the layers after the move, and a
# call uses the old name.
exits 1 slint check specs/keep.yaml
cmp stdout keep.txt

# The name must end with the suffix of the new layer.
exits 1 slint check specs/suffix.yaml
stdout '^specs/suffix.yaml:\d+ error SV114 ClaudeAccessor moves to the engine layer but does not end in Engine \(services.relayered\[0\]\)$'
stdout 'fix: Set rename: ClaudeEngine in this entry, and use the new name everywhere in the spec\.$'

-- .speclint.yaml --
-- .speclint/data/services.yaml --
services:
  HookCommand: { layer: client, calls: [ClaudeAccessor] }
  ClaudeAccessor: { layer: accessor, calls: [StoreResource] }
  StoreResource: { layer: resource }
-- specs/move.yaml --
speclint: 1
id: MOVE-1
kind: chore
title: Move the hook protocol
summary: The hook event is a format, not stored data.
acceptance:
  - { id: AC1, text: "Given an event, when the hook runs, then it reads the event." }
calls:
  - { from: HookCommand, to: ClaudeHook, op: ReadEvent, covers: [AC1] }
services:
  relayered:
    - { name: ClaudeAccessor, layer: utility, rename: ClaudeHook, reason: The hook event is a format. }
removed_calls:
  - { from: ClaudeHook, to: StoreResource }
-- specs/nomove.yaml --
speclint: 1
id: MOVE-2
kind: chore
title: Call the hook protocol
summary: The hook reads the event.
acceptance:
  - { id: AC1, text: "Given an event, when the hook runs, then it reads the event." }
calls:
  - { from: HookCommand, to: ClaudeAccessor, op: ReadEvent, covers: [AC1] }
-- specs/keep.yaml --
speclint: 1
id: MOVE-3
kind: chore
title: Move the hook protocol
summary: The hook event is a format, not stored data.
acceptance:
  - { id: AC1, text: "Given an event, when the hook runs, then it reads the event." }
calls:
  - { from: HookCommand, to: ClaudeAccessor, op: ReadEvent, covers: [AC1] }
services:
  relayered:
    - { name: ClaudeAccessor, layer: utility, rename: ClaudeHook, reason: The hook event is a format. }
-- specs/suffix.yaml --
speclint: 1
id: MOVE-4
kind: chore
title: Move the hook protocol
summary: The hook event is calculated.
acceptance:
  - { id: AC1, text: "Given an event, when the hook runs, then it reads the event." }
calls:
  - { from: HookCommand, to: ClaudeAccessor, op: ReadEvent, covers: [AC1] }
services:
  relayered:
    - { name: ClaudeAccessor, layer: engine, reason: It calculates. }
-- keep.txt --
specs/keep.yaml:9 error SV101 ClaudeAccessor is not a registered service (calls[0].to)
    fix: This spec renames ClaudeAccessor to ClaudeHook in services.relayered. Use ClaudeHook.
specs/keep.yaml:12 warning SV203 ClaudeHook calls StoreResource in the registry, but after the move utilities cannot call resources (services.relayered[0])
    fix: This spec moves ClaudeHook, so fix the call. Add { from: ClaudeHook, to: StoreResource } to removed_calls (a top-level list of the spec). Then move the work to a service that ClaudeHook can call: utilities.
speclint checked 1 spec(s) and found 1 error(s) and 1 warning(s).
