# init --dry-run prints the changes and writes nothing.
mkdir $WORK/dry
cd $WORK/dry
exits 0 sv init --dry-run
cmp stdout $WORK/dry-run.txt
! exists .specval.yaml .claude specs .github
cd $WORK

# init creates the config, the data and policy files, the skill, the specs
# directory, and the hook.
exits 0 sv init
cmp stdout created.txt
exists specs
cmp .specval.yaml want/config.yaml
cmp .claude/settings.json want/settings.json
cmp .specval/data/services.yaml want/services.yaml
exists .specval/policy/project.rego .claude/skills/spec/SKILL.md .github/instructions/specval.instructions.md
! exists CLAUDE.md

# The new project passes check.
exits 0 sv check
stdout '^specval checked 0 spec\(s\) and found 0 error\(s\) and 0 warning\(s\).$'

# A second init changes nothing.
exits 0 sv init
cmp stdout exists.txt

# init adds the hook to a settings file and keeps the other settings.
cd $WORK/merge
exits 0 sv init
stdout '^hooked   .claude/settings.json$'
cmp .claude/settings.json $WORK/want/merged.json

# init uses the specs_dir of an existing config in the same directory.
cd $WORK/custom
exits 0 sv init
exists changes
! exists specs

# init stops, and writes nothing, if the settings file is not valid JSON.
cd $WORK/badjson
exits 2 sv init
! stdout .
stderr '^sv: .*/badjson/.claude/settings.json is not valid JSON: '
! exists .specval.yaml

-- merge/.claude/settings.json --
{"model": "opus", "hooks": {"PostToolUse": [{"matcher": "Bash", "hooks": [{"type": "command", "command": "echo hi"}]}]}}
-- custom/.specval.yaml --
specs_dir: changes
-- badjson/.claude/settings.json --
{not json
-- dry-run.txt --
create   .specval.yaml
create   .specval/data/services.yaml
create   .specval/policy/project.rego
create   .claude/skills/spec/SKILL.md
create   .github/instructions/specval.instructions.md
hook     .claude/settings.json

This is a dry run. sv init wrote nothing.

Add this line to CLAUDE.md, so that Claude uses the spec skill for each change:
  This project uses specval. Before you write code for a change, use the spec skill to write a spec that passes `sv check`.
-- created.txt --
created  .specval.yaml
created  .specval/data/services.yaml
created  .specval/policy/project.rego
created  .claude/skills/spec/SKILL.md
created  .github/instructions/specval.instructions.md
hooked   .claude/settings.json

Add this line to CLAUDE.md, so that Claude uses the spec skill for each change:
  This project uses specval. Before you write code for a change, use the spec skill to write a spec that passes `sv check`.
-- exists.txt --
exists   .specval.yaml
exists   .specval/data/services.yaml (services)
exists   .specval/policy/project.rego (rules)
exists   .claude/skills/spec/SKILL.md
exists   .github/instructions/specval.instructions.md
exists   .claude/settings.json (sv hook)

Add this line to CLAUDE.md, so that Claude uses the spec skill for each change:
  This project uses specval. Before you write code for a change, use the spec skill to write a spec that passes `sv check`.
-- want/services.yaml --
# The service registry: each service in the system, and its layer (client,
# manager, engine, accessor, resource, or utility). `package` tells where the
# code of the service is. `calls` lists the services that it calls today,
# also a call that breaks the layer rules. We recommend that you protect this
# file with CODEOWNERS.
services: {}
#  OrderManager: { layer: manager, package: src/orders, calls: [PricingEngine, OrderAccessor] }
#  PricingEngine: { layer: engine, package: src/pricing }
#  OrderAccessor: { layer: accessor, package: src/orders/db }
-- want/config.yaml --
# The specval configuration. A path is relative to this file.
specs_dir: specs
# The project rules: Rego files with the package specval.spec.<name> (specval
# runs it for each spec) or specval.registry.<name> (specval runs it one time,
# with the data only).
policy: [.specval/policy]
# The project data: YAML or JSON files. Each top-level key is data.project.<key>.
data: [.specval/data]
-- want/settings.json --
{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v sv >/dev/null 2>&1 || { echo 'specval cannot check specs, because sv is not on the PATH of Claude Code hooks. Tell the user to add the directory of sv to PATH in the shell profile, start Claude Code again, and run sv doctor.' >&2; exit 2; }; sv hook"
          }
        ]
      }
    ]
  }
}
-- want/merged.json --
{
  "model": "opus",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo hi"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v sv >/dev/null 2>&1 || { echo 'specval cannot check specs, because sv is not on the PATH of Claude Code hooks. Tell the user to add the directory of sv to PATH in the shell profile, start Claude Code again, and run sv doctor.' >&2; exit 2; }; sv hook"
          }
        ]
      }
    ]
  }
}
