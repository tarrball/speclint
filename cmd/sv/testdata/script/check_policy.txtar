# Project rules run with the baseline rules. specval does not load files named *_test.rego.
exits 1 sv check
cmp stdout check.txt

# A deny or warn rule without custom.id stops the load.
cp noid.rego .specval/policy/noid.rego
exits 2 sv check
stderr 'noid.rego:6: deny rule needs a METADATA block with custom.id$'
rm .specval/policy/noid.rego

# A Rego syntax error stops the load.
cp syntax.rego .specval/policy/syntax.rego
exits 2 sv check
stderr 'syntax.rego:'
rm .specval/policy/syntax.rego

# A finding that does not have the correct format is an error.
cp malformed.rego .specval/policy/malformed.rego
exits 2 sv check
stderr 'a rule returned a finding that does not have the correct format'
rm .specval/policy/malformed.rego

# A rule cannot use a built-in function that can give a different result each
# time, such as http.send or time.now_ns. Thus a rule cannot use the network.
cp network.rego .specval/policy/network.rego
exits 2 sv check
stderr 'network.rego:10: .*undefined function http.send'
rm .specval/policy/network.rego
cp clock.rego .specval/policy/clock.rego
exits 2 sv check
stderr 'clock.rego:10: .*undefined function time.now_ns'
rm .specval/policy/clock.rego

# The built-in rule SV001 uses json.match_schema. A project rule cannot use it,
# because a schema can load a remote $ref.
cp schema.rego .specval/policy/schema.rego
exits 2 sv check
stderr 'schema.rego:10: a project rule cannot use json.match_schema, because a schema can load a remote \$ref$'

-- .specval.yaml --
-- .specval/data/services.yaml --
services:
  OrderManager: { layer: manager }
  OrderAccessor: { layer: accessor }
-- .specval/data/limits.json --
{"limits": {"max_calls": 1}}
-- .specval/policy/project.rego --
package specval.spec.project

import data.specval.lib
import rego.v1

# METADATA
# title: Specs have a short title
# description: Titles are at most 20 characters.
# custom:
#   id: PRJ201
warn contains f if {
	count(input.title) > 20
	f := lib.finding(rego.metadata.rule(), "title", "The title is too long", "Shorten the title.")
}

# METADATA
# title: Specs stay small
# custom:
#   id: PRJ001
deny contains f if {
	count(input.calls) > data.project.limits.max_calls
	f := lib.finding(rego.metadata.rule(), "calls", "Too many calls", "Split the spec.")
}
-- .specval/policy/project_test.rego --
package specval.spec.project_test

this is not valid rego, and specval must not load it
-- .specval/policy/registry.rego --
package specval.registry.project

import data.specval.lib
import rego.v1

# METADATA
# title: Accessors are listed
# custom:
#   id: PRJ900
warn contains f if {
	not data.project.services.CustomerAccessor
	f := lib.finding(rego.metadata.rule(), "services", "No CustomerAccessor", "Register CustomerAccessor.")
}
-- specs/A-1.yaml --
specval: 1
id: A-1
kind: feature
title: A title that is longer than twenty characters
summary: Two calls.
acceptance:
  - { id: AC1, text: "Given an order, when it is read, then it is returned." }
calls:
  - { from: OrderManager, to: OrderAccessor, op: GetOrder, covers: [AC1] }
  - { from: OrderManager, to: OrderAccessor, op: GetLines, covers: [AC1] }
-- noid.rego --
package specval.spec.noid

import rego.v1

# A rule without METADATA.
deny contains "no id" if true
-- syntax.rego --
package specval.spec.syntax

deny contains f if {
-- malformed.rego --
package specval.spec.malformed

import rego.v1

# METADATA
# title: Returns a string
# custom:
#   id: BAD001
deny contains "not an object" if true
-- network.rego --
package specval.spec.network

import rego.v1

# METADATA
# title: Uses the network
# custom:
#   id: BAD002
deny contains f if {
	r := http.send({"method": "GET", "url": "http://127.0.0.1:9/"})
	f := {"rule": "BAD002", "path": "", "msg": r.body, "fix": ""}
}
-- clock.rego --
package specval.spec.clock

import rego.v1

# METADATA
# title: Uses the clock
# custom:
#   id: BAD003
deny contains f if {
	t := time.now_ns()
	f := {"rule": "BAD003", "path": "", "msg": sprintf("%d", [t]), "fix": ""}
}
-- schema.rego --
package specval.spec.remote

import rego.v1

# METADATA
# title: Uses a remote schema
# custom:
#   id: BAD004
deny contains f if {
	[ok, _] := json.match_schema(input, {"$ref": "http://127.0.0.1:9/schema.json"})
	not ok
	f := {"rule": "BAD004", "path": "", "msg": "no match", "fix": ""}
}
-- check.txt --
.specval/data/services.yaml:1 warning PRJ900 No CustomerAccessor (services)
    fix: Register CustomerAccessor.
specs/A-1.yaml:4 warning PRJ201 The title is too long (title)
    fix: Shorten the title.
specs/A-1.yaml:8 error PRJ001 Too many calls (calls)
    fix: Split the spec.
specval checked 1 spec(s) and found 1 error(s) and 2 warning(s).
