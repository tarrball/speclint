{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "specval spec",
  "type": "object",
  "required": ["specval", "id", "kind", "title", "summary", "acceptance", "calls"],
  "additionalProperties": false,
  "properties": {
    "specval": { "const": 1, "description": "Spec format version; always 1." },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Ticket id, e.g. ORD-142 (letters, digits, . _ -). The file is specs/<id>.yaml."
    },
    "kind": { "enum": ["feature", "bugfix", "chore"], "description": "One of: feature, bugfix, chore." },
    "title": { "type": "string", "minLength": 1, "description": "One-line title of the change." },
    "summary": { "type": "string", "minLength": 1, "description": "A short paragraph: the problem and the intended behavior." },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "description": "Testable acceptance criteria; at least one.",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^AC[0-9]+$", "description": "AC followed by a number, e.g. AC1." },
          "text": { "type": "string", "minLength": 1, "description": "A testable statement: Given ..., when ..., then ...." }
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "new": {
          "type": "array",
          "description": "Services this change introduces.",
          "items": {
            "type": "object",
            "required": ["name", "layer", "purpose"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$", "description": "PascalCase name ending in its layer suffix, e.g. RefundEngine." },
              "layer": { "type": "string", "description": "The service's layer, e.g. engine." },
              "purpose": { "type": "string", "minLength": 1, "description": "One sentence on what the service is responsible for." }
            }
          }
        },
        "changed": {
          "type": "array",
          "description": "Registered services whose behavior this change alters.",
          "items": { "type": "string" }
        }
      }
    },
    "calls": {
      "type": "array",
      "description": "Every service-to-service call the change adds or alters.",
      "items": {
        "type": "object",
        "required": ["from", "to", "op", "covers"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string", "description": "Calling service." },
          "to": { "type": "string", "description": "Called service." },
          "op": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$", "description": "PascalCase operation name, e.g. CalculateRefund." },
          "covers": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "Acceptance criteria this call helps satisfy, e.g. [AC1]."
          }
        }
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Things a reader might expect this change to do that it deliberately does not."
    }
  }
}
